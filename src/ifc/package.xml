<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>ifc</name>
    <version>0.0.0</version>
    <description>In-flight calibration launch files.</description>
    <maintainer email="wggajda@gmail.com">Wojciech Gajda</maintainer>
    <license>TODO</license>

    <buildtool_depend>ament_cmake</buildtool_depend>

    <exec_depend>calibration_manager</exec_depend>
    <exec_depend>delay_estimator</exec_depend>
    <exec_depend>feature_tracker</exec_depend>
    <exec_depend>horizon_detection</exec_depend>
    <exec_depend>launch</exec_depend>
    <exec_depend>launch_ros</exec_depend>
    <exec_depend>stream_telemetry</exec_depend>
    <exec_depend>telemetry_synchronizer</exec_depend>

    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>
